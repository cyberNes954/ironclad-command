import os
import json
import urllib.request
import urllib.error
from pathlib import Path

KB_ROOT = Path("knowledge_base")
MAX_CHARS = 280000

SYSTEM_PROMPT = """You are IRONCLAD COMMAND - master operations brain of Ironclad Logistic,
a truck dispatch service in Fort Lauderdale, Florida (954) 634-2388.

Answer ONLY from the knowledge base below. Never guess. If the answer is not there, say:
"That is not in my knowledge base yet - upload the source."

BUSINESS RULES:
- No forced dispatch, ever. The carrier approves every load.
- Rates must be backed by CPM math (break-even + 15-25% profit).
- No Rate Confirmation = No Dispatch.
- Notify the broker within 15 minutes when detention starts.
- Send POD to the broker within 2 hours of delivery.
- Vet carriers on SAFER before onboarding. Unsatisfactory rating = do not use.
- Dispatch fee = percent of gross line-haul, invoiced weekly on Friday.

STYLE: Direct, professional, no fluff. Name the document you used. Flag risks immediately.

KNOWLEDGE BASE:
{context}"""


class IroncladBrain:
    def __init__(self):
        self.api_key = os.environ.get("GROQ_API_KEY", "")
        self.files = []
        self.rebuild_index()

    def rebuild_index(self):
        self.files = []
        if not KB_ROOT.exists():
            return
        for md in sorted(KB_ROOT.rglob("*.md")):
            try:
                text = md.read_text(encoding="utf-8", errors="ignore")
            except Exception:
                continue
            self.files.append({
                "name": md.name,
                "text": "=== [%s] %s ===\n%s" % (md.parent.name, md.name, text),
            })

    def _context(self, question):
        total = sum(len(f["text"]) for f in self.files)
        if total <= MAX_CHARS:
            return "\n\n".join(f["text"] for f in self.files)
        words = {w.lower() for w in question.split() if len(w) > 3}
        scored = sorted(
            self.files,
            key=lambda f: sum(1 for w in words if w in f["text"].lower()),
            reverse=True,
        )
        out, size = [], 0
        for f in scored:
            if size + len(f["text"]) > MAX_CHARS:
                continue
            out.append(f["text"])
            size += len(f["text"])
        return "\n\n".join(out)

    def ask(self, question):
        if not self.api_key:
            return {"answer": "GROQ_API_KEY is missing. Add it in Streamlit Secrets.", "sources": []}
        if not self.files:
            return {"answer": "Knowledge base is empty. Upload documents in the Teach Me tab.", "sources": []}
        payload = {
            "model": "llama-3.3-70b-versatile",
            "messages": [
                {"role": "system", "content": SYSTEM_PROMPT.format(context=self._context(question))},
                {"role": "user", "content": question},
            ],
            "temperature": 0.2,
            "max_tokens": 1024,
        }
        req = urllib.request.Request(
            "https://api.groq.com/openai/v1/chat/completions",
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Authorization": "Bearer " + self.api_key,
                "Content-Type": "application/json",
                "User-Agent": "IroncladCommand/1.0",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=90) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            return {"answer": data["choices"][0]["message"]["content"], "sources": []}
        except urllib.error.HTTPError as e:
            body = e.read().decode("utf-8", "ignore")[:500]
            return {"answer": "Groq API error %s: %s" % (e.code, body), "sources": []}
        except Exception as e:
            return {"answer": "Request failed: %s" % e, "sources": []}